using System;
using System.Collections.Generic;
using System.IO;
using System.Net.Http;
using System.Net.Http.Headers;
using System.Text;
using System.Threading.Tasks;
using Newtonsoft.Json;
using OfficeOpenXml;

class Program
{
    static async Task Main(string[] args)
    {
        // 🔹 GitHub Repository Details
        string owner = "charlesschwab";  // GitHub owner or organization name
        string repo = "mobile-accounts-bff";  // Repository name
        string branch = "main";  // Branch to fetch files from
        
        // 🔹 Excel file paths
        string excelFilePath = "cms_ids.xlsx";  // Input Excel file containing CMS IDs
        string outputFilePath = "results.xlsx";  // Output file where results will be saved
        
        // 🔹 GitHub Authentication Tokens (Use multiple to handle rate limits)
        List<string> tokens = new List<string> { "ghp_xxx", "ghp_yyy" };

        // 🔹 Read CMS IDs from the Excel file
        List<string> cmsIds = ReadIDsFromExcel(excelFilePath);

        // 🔹 Store results where ID matches in a file
        List<SearchResultWithId> results = new List<SearchResultWithId>();

        // 🔹 Loop through each CMS ID to search in the repository
        foreach (string id in cmsIds)
        {
            List<SearchResult> searchResults = await SearchCodeOnGitHub(owner, repo, id, tokens);
            
            foreach (var result in searchResults)
            {
                // 🔹 Fetch the file content where the search result was found
                string fileContent = await FetchFileContent(owner, repo, result.Path, branch, tokens);

                // 🔹 Check if the file contains the ID (either in quotes or raw)
                if (fileContent.Contains($"\"{id}\"") || fileContent.Contains($"'{id}'") || fileContent.Contains(id))
                {
                    // 🔹 Add to results if match found
                    results.Add(new SearchResultWithId
                    {
                        Id = id,
                        Repository = result.Repository,
                        Path = result.Path,
                        Url = result.Url
                    });
                }
            }
        }

        // 🔹 Save the final results to an Excel file
        WriteResultsToExcel(results, outputFilePath);
        Console.WriteLine($"✅ Process Completed. Results saved in {outputFilePath}");
    }

    // 🔹 Reads CMS IDs from an Excel file
    static List<string> ReadIDsFromExcel(string filePath)
    {
        ExcelPackage.LicenseContext = LicenseContext.NonCommercial;  // Required for using EPPlus
        List<string> ids = new List<string>();

        using (var package = new ExcelPackage(new FileInfo(filePath)))
        {
            var worksheet = package.Workbook.Worksheets[0];  // Read first worksheet
            int rowCount = worksheet.Dimension.Rows;  // Get total rows

            for (int row = 2; row <= rowCount; row++)  // Assuming first row is a header
            {
                string id = worksheet.Cells[row, 1].Text;  // Read ID from column 1
                if (!string.IsNullOrEmpty(id))
                    ids.Add(id);  // Store only non-empty IDs
            }
        }
        return ids;
    }

    // 🔹 Search for occurrences of CMS IDs in the GitHub repository
    static async Task<List<SearchResult>> SearchCodeOnGitHub(string owner, string repo, string query, List<string> tokens)
    {
        List<SearchResult> results = new List<SearchResult>();
        using (HttpClient client = new HttpClient())
        {
            int tokenIndex = 0;
            int page = 1, perPage = 10;  // Pagination settings

            while (true)
            {
                string token = tokens[tokenIndex];
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
                client.DefaultRequestHeaders.Add("User-Agent", "CSharp-Console-App");

                // 🔹 GitHub Search API URL for searching code
                string searchUrl = $"https://api.github.com/search/code?q={query}+repo:{owner}/{repo}&per_page={perPage}&page={page}";

                HttpResponseMessage response = await client.GetAsync(searchUrl);

                if (response.IsSuccessStatusCode)
                {
                    string jsonResponse = await response.Content.ReadAsStringAsync();
                    var searchResponse = JsonConvert.DeserializeObject<SearchResponse>(jsonResponse);
                    
                    if (searchResponse?.Items != null)
                        results.AddRange(searchResponse.Items);  // Store search results

                    if (searchResponse?.Items.Count < perPage) break;  // Stop if fewer results returned
                    page++;
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden) // API Rate limit hit
                {
                    tokenIndex = (tokenIndex + 1) % tokens.Count;
                    if (tokenIndex == 0) // All tokens exhausted
                    {
                        Console.WriteLine("❌ All tokens exhausted. Retrying in 1 minute...");
                        await Task.Delay(60000);
                    }
                }
                else break; // Other errors, exit loop
            }
        }
        return results;
    }

    // 🔹 Fetch the content of a file from a private GitHub repository
    static async Task<string> FetchFileContent(string owner, string repo, string filePath, string branch, List<string> tokens)
    {
        using (HttpClient client = new HttpClient())
        {
            int tokenIndex = 0;

            while (true)
            {
                string token = tokens[tokenIndex];
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
                client.DefaultRequestHeaders.Add("User-Agent", "CSharp-Console-App");

                // 🔹 GitHub API to get file contents
                string apiUrl = $"https://api.github.com/repos/{owner}/{repo}/contents/{filePath}?ref={branch}";

                HttpResponseMessage response = await client.GetAsync(apiUrl);

                if (response.IsSuccessStatusCode)
                {
                    string jsonResponse = await response.Content.ReadAsStringAsync();
                    var contentData = JsonConvert.DeserializeObject<FileContentResponse>(jsonResponse);

                    if (contentData?.Content != null)
                    {
                        return Encoding.UTF8.GetString(Convert.FromBase64String(contentData.Content));  // Decode Base64 content
                    }
                    return "";
                }

                if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
                {
                    tokenIndex = (tokenIndex + 1) % tokens.Count;
                    if (tokenIndex == 0)
                    {
                        Console.WriteLine("❌ All tokens exhausted. Retrying in 1 minute...");
                        await Task.Delay(60000);
                    }
                    continue;
                }

                return "";
            }
        }
    }

    // 🔹 Write the matched results to an Excel file
    static void WriteResultsToExcel(List<SearchResultWithId> results, string filePath)
    {
        ExcelPackage.LicenseContext = LicenseContext.NonCommercial;

        using (var package = new ExcelPackage())
        {
            var worksheet = package.Workbook.Worksheets.Add("Results");
            worksheet.Cells[1, 1].Value = "ID";
            worksheet.Cells[1, 2].Value = "Repository";
            worksheet.Cells[1, 3].Value = "File Path";
            worksheet.Cells[1, 4].Value = "URL";

            int row = 2;
            foreach (var result in results)
            {
                worksheet.Cells[row, 1].Value = result.Id;
                worksheet.Cells[row, 2].Value = result.Repository.FullName;
                worksheet.Cells[row, 3].Value = result.Path;
                worksheet.Cells[row, 4].Value = result.Url;
                row++;
            }

            package.SaveAs(new FileInfo(filePath));  // Save the file
        }
    }

    // 🔹 Supporting Classes
    class SearchResponse { [JsonProperty("items")] public List<SearchResult> Items { get; set; } }
    class SearchResult { public Repository Repository { get; set; } public string Path { get; set; } public string Url { get; set; } }
    class Repository { public string FullName { get; set; } }
    class SearchResultWithId { public string Id { get; set; } public Repository Repository { get; set; } public string Path { get; set; } public string Url { get; set; } }
    class FileContentResponse { [JsonProperty("content")] public string Content { get; set; } }
}
