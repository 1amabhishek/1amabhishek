            var batch = ids.GetRange(i, Math.Min(batchSize, ids.Count - i));
            Console.WriteLine($"Processing batch {i / batchSize + 1}: {string.Join(", ", batch)}");

            foreach (var id in batch)
            {
                Console.WriteLine($"Searching for ID: {id}");

                var results = await SearchGitHub(id, tokens);
                processedCount++;

                foreach (var result in results)
                {
                    bool isMatch = await VerifyIdInFile(result, id, tokens);
                    if (isMatch)
                    {
                        Console.WriteLine($"ID {id} found in {result.Path}");
                        allResults.Add(result);
                    }
                    else
                    {
                        Console.WriteLine($"ID {id} NOT found in {result.Path}");
                    }
                }
            }

            if (processedCount >= sleepThreshold)
            {
                Console.WriteLine($"Processed {processedCount} IDs. Sleeping for 1 minute...");
                await Task.Delay(60 * 1000);
                processedCount = 0;
            }
        }

