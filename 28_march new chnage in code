using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Net.Http;
using System.Net.Http.Headers;
using System.Text;
using System.Threading.Tasks;
using Newtonsoft.Json;
using OfficeOpenXml;

class Program
{
    static async Task Main(string[] args)
    {
        // List of GitHub Personal Access Tokens (to handle rate limits)
        List<string> tokens = new List<string>
        {
            // Add your GitHub tokens here
        };

        // Get Excel file path containing search IDs
        string excelFilePath = "C:\\Development\\Github search app\\Github-search-Ids.xlsx";

        if (!File.Exists(excelFilePath))
        {
            Console.WriteLine("Error: Excel file not found.");
            return;
        }

        // Get directory for output file
        string outputDirectory = "C:\\Development\\Github search app";

        if (!Directory.Exists(outputDirectory))
        {
            Console.WriteLine("Error: Output directory does not exist.");
            return;
        }

        Console.WriteLine("Reading IDs from Excel file...");
        var ids = ReadIdsFromExcel(excelFilePath);

        int batchSize = 5;  // Number of IDs processed per batch
        int sleepThreshold = 180;  // Pause after processing this many IDs
        int processedCount = 0;  // Track processed IDs

        Console.WriteLine("Searching GitHub for IDs...");
        var allResults = new List<SearchResultWithId>();

        // Process search IDs in batches
        for (int i = 0; i < ids.Count; i += batchSize)
        {
            var batch = ids.GetRange(i, Math.Min(batchSize, ids.Count - i));
            Console.WriteLine($"Processing batch {i / batchSize + 1}: {string.Join(", ", batch)}");

            var batchResults = new List<SearchResultWithId>();

            // Process each ID in the batch
            foreach (var id in batch)
            {
                Console.WriteLine($"Searching for ID: {id}");
                var results = await SearchGitHub(id, tokens);
                processedCount++;

                // If no results found, add a placeholder
                if (results.Count == 0)
                {
                    batchResults.Add(new SearchResultWithId
                    {
                        Id = id,
                        Repository = new Repository { FullName = "NULL" },
                        Path = "NULL",
                        Url = "NULL"
                    });
                }
                else
                {
                    batchResults.AddRange(results);
                }
            }

            // Store batch results
            allResults.AddRange(batchResults);

            // Pause if threshold is reached
            if (processedCount >= sleepThreshold)
            {
                Console.WriteLine($"Processed {processedCount} IDs. Sleeping for 1 minute...");
                await Task.Delay(60 * 1000);
                processedCount = 0;
            }
        }

        // Write results to Excel file
        Console.WriteLine("Writing results to Excel...");
        string outputFilePath = Path.Combine(outputDirectory, "GitHubSearchResults.xlsx");
        WriteResultsToExcel(allResults, outputFilePath);
        Console.WriteLine($"Results written to {outputFilePath}");
    }

    /// <summary>
    /// Searches GitHub for the given query and returns matching files.
    /// </summary>
    static async Task<List<SearchResultWithId>> SearchGitHub(string query, List<string> tokens)
    {
        const int perPage = 100;  // Maximum results per API call
        int page = 1;  // Pagination tracking
        var allResults = new List<SearchResultWithId>();
        int retryDelay = 5;
        int tokenIndex = 0;  // Track which token is in use

        using (HttpClient client = new HttpClient())
        {
            while (true)
            {
                // Set authentication token
                string currentToken = tokens[tokenIndex];
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", currentToken);
                client.DefaultRequestHeaders.Add("User-Agent", "CSharp-Console-App");

                // GitHub API URL for searching code
                string url = $"https://api.github.com/search/code?q={query}+user:charlesschwab&per_page={perPage}&page={page}";
                HttpResponseMessage response;

                try
                {
                    response = await client.GetAsync(url);
                }
                catch (HttpRequestException ex)
                {
                    Console.WriteLine($"Network Error: {ex.Message}. Retrying in {retryDelay} seconds...");
                    await Task.Delay(retryDelay * 1000);
                    retryDelay = Math.Min(retryDelay * 2, 60);
                    continue;
                }

                if (!response.IsSuccessStatusCode)
                {
                    // Handle different error codes
                    if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized ||
                        response.StatusCode == System.Net.HttpStatusCode.ProxyAuthenticationRequired)
                    {
                        Console.WriteLine("Auth error. Switching to next token...");
                        tokenIndex = (tokenIndex + 1) % tokens.Count;

                        if (tokenIndex == 0)
                        {
                            Console.WriteLine("All tokens exhausted. Please check your credentials.");
                            break;
                        }
                        continue;
                    }
                    else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
                    {
                        Console.WriteLine("Rate limit reached (403). Waiting before retrying...");
                        await Task.Delay(60 * 1000);
                        continue;
                    }

                    Console.WriteLine($"Error {response.StatusCode}: {response.ReasonPhrase}");
                    break;
                }

                string responseBody = await response.Content.ReadAsStringAsync();
                var searchResponse = JsonConvert.DeserializeObject<SearchResponse>(responseBody);

                if (searchResponse?.Items == null || searchResponse.Items.Count == 0)
                    break;

                foreach (var item in searchResponse.Items)
                {
                    var result = new SearchResultWithId
                    {
                        Id = query,
                        Repository = item.Repository,
                        Path = item.Path,
                        Url = item.HtmlUrl
                    };

                    // Verify if the ID is inside the file
                    bool isMatch = await VerifyIdInFile(result, query, tokens);

                    if (isMatch)
                    {
                        allResults.Add(result);
                    }
                }

                if (searchResponse.Items.Count < perPage)
                    break;

                page++;
            }
        }

        return allResults;
    }

    /// <summary>
    /// Fetches the actual file content and checks if the ID is present.
    /// </summary>
    static async Task<bool> VerifyIdInFile(SearchResultWithId result, string id, List<string> tokens)
    {
        using (HttpClient client = new HttpClient())
        {
            // Extract owner and repo name
            string[] repoParts = result.Repository.FullName.Split('/');
            if (repoParts.Length < 2) return false;

            string owner = repoParts[0];
            string repo = repoParts[1];
            string branch = "main";  // Assume "main" branch (can be improved)
            string filePath = result.Path;

            // Construct raw file URL
            string rawUrl = $"https://raw.githubusercontent.com/{owner}/{repo}/{branch}/{filePath}";

            try
            {
                HttpResponseMessage response = await client.GetAsync(rawUrl);

                if (response.IsSuccessStatusCode)
                {
                    string fileContent = await response.Content.ReadAsStringAsync();
                    return fileContent.Contains(id);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error fetching file: {ex.Message}");
            }
        }

        return false;
    }
}

//Supporting Classes
class SearchResponse { [JsonProperty("items")] public List<SearchResult> Items { get; set; } }
class SearchResult { public Repository Repository { get; set; } public string Path { get; set; } public string HtmlUrl { get; set; } }
class Repository { [JsonProperty("full_name")] public string FullName { get; set; } }
class SearchResultWithId { public string Id { get; set; } public Repository Repository { get; set; } public string Path { get; set; } public string Url { get; set; } }
